# Скопируйте в .env и поправьте под свой сервер
APP_NAME=Miniage
APP_ENV=production

# mysql | sqlite
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=miniage
DB_USER=miniage
DB_PASS=change_me

# Используется при DB_DRIVER=sqlite (и как аварийный fallback)
DB_SQLITE_PATH=var/miniage.sqlite

SESSION_NAME=miniage_sid
SESSION_TTL=86400
SEED_DEMO=1
TIMEZONE=Europe/Moscow
